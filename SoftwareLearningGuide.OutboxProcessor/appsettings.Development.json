{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "MassTransit": "Information"
    }
  },
  "Database": {
    "SoftwareLearningGuide": "Server=localhost,1433;Database=SoftwareLearningGuide;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True;"
  },
  "MessageBroker": {
    "Host": "localhost",
    "Username": "guest",
    "Password": "guest"
  },
  "OpenTelemetry": {
    "ServiceName": "SoftwareLearningGuide.OutboxProcessor",
    "Otlp": {
      "Endpoint": "http://localhost:4317",
      "Protocol": "grpc"
    }
  },
  "ResilienceConfiguration": {
    "MessageBrokerApi": {
      "Retry": {
        "MaxRetryCount": 3,
        "InitialRetryIntervalSeconds": 1,
        "MaxRetryIntervalSeconds": 30,
        "IntervalDeltaSeconds": 5
      },
      "CircuitBreaker": {
        "TripThreshold": 15,
        "ActiveThreshold": 10,
        "TrackingPeriodMinutes": 1,
        "ResetIntervalMinutes": 5
      },
      "TimeOut": {
        "TimeoutSeconds": 30
      }
    }
  },
  "CloudProvidersConfigurations": {
    "AWS": {
      "Enabled": true,
      "Credentials": {
        "AccessKey": "test",
        "AccessSecret": "test"
      },
      "SSM": {
        "Enabled": true,
        "Path": "/softwarelearningguide/dev/outboxprocessor/",
        "Region": "us-east-1",
        "ServiceUrl": "http://localhost:4566",
        "ReloadIntervalSeconds": 300
      }
    }
  }
}
